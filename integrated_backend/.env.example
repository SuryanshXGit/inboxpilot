# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection string. Works with Supabase Postgres, Neon or any
# standard PostgreSQL instance. Use the pooled/session connection string for
# serverless deployments and keep it server-side only.
# Example: postgresql://user:password@db.example.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Secret used to sign local HS256 JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional comma-separated CORS allow-list. Defaults to "*".
CORS_ORIGINS=*

# Application log level (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Path to the InboxPilot static frontend (relative paths resolve against the
# repository root). The app serves it at /inboxpilot/ when the directory
# exists; leave blank to run the API only.
INBOXPILOT_DIR=../frontend

# ---------------------------------------------------------------------------
# AI engine: provider selection
# ---------------------------------------------------------------------------
# Primary provider: groq | openai | gemini
AI_PRIMARY_PROVIDER=groq
# Fallback provider (tried once if the primary is unavailable); use "none" to disable.
AI_FALLBACK_PROVIDER=openai

# Reliability (bounded retries; never infinite).
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
AI_RETRY_BACKOFF_SECONDS=0.5
AI_MAX_OUTPUT_TOKENS=2500
AI_TEMPERATURE=0.2

# Prompt-size guards.
AI_MAX_MATERIAL_CHARS=12000
AI_MAX_CONVERSATION_MESSAGES=10

# ---------------------------------------------------------------------------
# Groq (Primary by default; high-speed inference)
# ---------------------------------------------------------------------------
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# gpt-oss reasoning depth: low keeps latency in the low seconds (none disables).
GROQ_REASONING_EFFORT=low

# ---------------------------------------------------------------------------
# OpenAI (Fallback by default)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible gateway / proxy base URL, e.g. Neon AI Gateway.
OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# Optional Google OAuth & Gmail API (Production Gmail sync)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.com/api/v1/emails/oauth/google/callback

# ---------------------------------------------------------------------------
# Optional Google Gemini
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ---------------------------------------------------------------------------
# Object storage (preserved from Person 1's project; used by ingestion work)
# ---------------------------------------------------------------------------
AWS_ENDPOINT_URL_S3=https://your-s3-endpoint.example.com
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=eu-central-1

# ---------------------------------------------------------------------------
# Neon AI Gateway (optional; preserved from Person 1's project)
# ---------------------------------------------------------------------------
NEON_AI_GATEWAY_TOKEN=your-neon-ai-gateway-token
